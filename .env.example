# Use a unique password with at least 14 characters. Never commit a real value.
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_TOTP_SECRET=replace-with-a-32-character-base32-secret

# Required in production: generate 32 bytes and encode them as 64 hex characters.
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-for-this-deployment

# Production only. Set to the exact public HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://showroom.example.com

# Optional. Defaults to ./data, outside the static build output.
DATA_DIR=./data

# Optional behind a reverse proxy. Set only if the proxy overwrites X-Real-IP.
TRUSTED_PROXY_ADDRESS=127.0.0.1
